    <shapes />
    <txttips>
        <txttip left="438" top="110" right="744" bottom="158" content="192.168.10.0/24     业务1       vlan 10&#x0D;&#x0A;192.168.20.0/24     业务2       vlan 20&#x0D;&#x0A;192.168.88.0/24     设备管理    vlan 88" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="419" top="169" right="1020" bottom="233" content="access口连接终端或者路由器/防火墙等三层设备&#x0D;&#x0A;网关就相当于默认路由&#x0D;&#x0A;arp协议是通过IP地址查询MAC&#x0D;&#x0A;acl有高级的ACL和基础ACL，基础ACL只能写源地址。高级ACL可以写源目IP/源目端口/协议" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="725" top="297" right="1250" bottom="345" content="192.168.10.2--192.168.10.1查路由表-通过88.0段查询到，然后查询ARP表，&#x0D;&#x0A;转发到24口交给二层接入，二层接入根据这个IP查询自己设备的路由表，&#x0D;&#x0A;那么就可以收到这个数据包。" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="162" top="138" right="257" bottom="155" content="100.1.1.1/30" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="1173" top="132" right="1570" bottom="227" content="路由优先级，优先值越高的，它的优先级越低&#x0D;&#x0A;直连路由：配置IP地址就直接生成的。优先级最高&#x0D;&#x0A;静态路由：手动配置。&#x0D;&#x0A;          明细路由和模糊路由。&#x0D;&#x0A;动态路由：一端配置之后，另外一端自动生成不需要配置。&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
    </txttips>
</topo>
