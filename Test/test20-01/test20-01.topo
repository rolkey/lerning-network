    <txttips>
        <txttip left="271" top="577" right="547" bottom="719" content="核心交换机：hexin&#x0D;&#x0A;VLAN 100 连防火墙：10.100.1.2&#x0D;&#x0A;VLAN 101 管理：10.101.1.1&#x0D;&#x0A;G0/0/24：vlan100&#x0D;&#x0A;&#x0D;&#x0A;VLAN 10（员工区）: 10.1.1.1&#x0D;&#x0A;VLAN 20（服务器区）:10.2.1.1&#x0D;&#x0A;VLAN 30（维护人员）:10.3.1.1（DHCP）&#x0D;&#x0A;VLAN 40（监控区）:10.4.1.1" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="645" top="440" right="823" bottom="519" content="FW-OA1：办公区防火墙&#x0D;&#x0A;G1/0/6 dhcp客户端&#x0D;&#x0A;G1/0/5 192.168.21.10/24&#x0D;&#x0A;G1/0/0 10.100.1.1/24&#x0D;&#x0A;回程路由,nat转发" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
