        <txttip left="1077" top="711" right="1149" bottom="728" content="10.2.1.10" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="891" top="249" right="1152" bottom="313" content="用低配置的交换机做WIFI设备上网通道&#x0D;&#x0A;患者服务路由做DHCP与NAT&#x0D;&#x0A;LSW6:&#x0D;&#x0A;G0/0/1 192.168.100.2/24" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
